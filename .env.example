# =====================================================================
# Plantilla de secretos. Copie este archivo como .env y complete los
# valores. El archivo .env está excluido de git (.gitignore).
# Lo leen el nodo de borde (python-dotenv) y el servidor (dotenv).
# =====================================================================

# --- Broker EMQX Cloud (Serverless) ---
# Dirección del despliegue, sin protocolo ni puerto (consola de EMQX Cloud > Overview).
MQTT_HOST=xxxxxxxx.ala.us-east-1.emqxsl.com
# MQTT sobre TLS: nodo de borde y servidor.
MQTT_PORT_TLS=8883
# MQTT sobre WebSocket seguro (WSS): tablero web en el navegador.
MQTT_PORT_WSS=8084
MQTT_WSS_PATH=/mqtt

# --- Credenciales (EMQX Cloud > Access Control > Authentication) ---
# "edge": nodo de borde. Publica estado, detecciones, cuadro e inspeccion; se suscribe a comando.
EDGE_USER=edge
EDGE_PASS=cambiar_esta_clave
# "servidor": servidor Node. Se suscribe a cacao/# y publica el comando de inicio.
SERVIDOR_USER=servidor
SERVIDOR_PASS=cambiar_esta_clave
# "tablero": solo se suscribe. El servidor la entrega al navegador en GET /api/config/mqtt.
TABLERO_USER=tablero
TABLERO_PASS=cambiar_esta_clave

# --- MongoDB Atlas ---
# Cadena de conexión del clúster (Connect > Drivers). Incluya el nombre de la base.
# Si Node falla con "querySrv ECONNREFUSED" o "querySrv ETIMEOUT", use la cadena
# estándar (mongodb://host1:27017,host2:27017,host3:27017/cacao?tls=true&replicaSet=...&authSource=admin)
# con los hosts del registro SRV y el replicaSet del registro TXT del clúster.
MONGODB_URI=mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/cacao?retryWrites=true&w=majority

# --- Servidor web (Express) ---
PUERTO_HTTP=3000
# 127.0.0.1 = solo este equipo (recomendado). 0.0.0.0 abre la API a toda la red,
# y la API no tiene autenticación: úselo solo en una red de confianza.
HOST_HTTP=127.0.0.1
